{
  "name": "qrauth-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "QRAuth: offline iPhone client (PWA) for the pam_qrauth challenge-response PAM module",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:webkit": "playwright test",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
